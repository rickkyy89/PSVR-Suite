@@ -154,6 +154,49 @@ ps3eye_grab_frame(ps3eye_t *eye, unsigned char* frame)
 	eye->eye->getFrame(frame);
 }
 
+int
+ps3eye_grab_frame_timeout(ps3eye_t *eye, unsigned char* frame, int timeout_ms)
+{
+    if (!ps3eye_context) {
+        // No context available
+        return -1;
+    }
+
+    if (!eye) {
+        // Eye is not a valid handle
+        return -1;
+    }
+
+    return eye->eye->tryGetFrame(frame, timeout_ms) ? 1 : 0;
+}
+
+void
+ps3eye_abort_frame(ps3eye_t *eye)
+{
+    if (!ps3eye_context) {
+        // No context available
+        return;
+    }
+
+    if (!eye) {
+        // Eye is not a valid handle
+        return;
+    }
+
+    eye->eye->abortFrameWait();
+}
+
+int
+ps3eye_get_frame_rate(ps3eye_t *eye)
+{
+    if (!eye) {
+        // Eye is not a valid handle
+        return 0;
+    }
+
+    return (int)eye->eye->getFrameRate();
+}
+
