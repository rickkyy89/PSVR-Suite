if(CASE STREQUAL "unknown_option")
    set(args --power-on)
    set(expected "unknown option")
elseif(CASE STREQUAL "missing_config")
    set(args --config "${CMAKE_CURRENT_BINARY_DIR}/nonexistent-psvr-config.json")
    set(expected "cannot open config")
elseif(CASE STREQUAL "invalid_config")
    set(args --config "${FIXTURE}")
    set(expected "invalid diagnostic config")
else()
    message(FATAL_ERROR "Unknown test case")
endif()
execute_process(COMMAND "${DIAG}" ${args} RESULT_VARIABLE result
    OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 10)
if(NOT result STREQUAL "1" OR NOT error MATCHES "${expected}" OR output MATCHES "USB detection started")
    message(FATAL_ERROR "Expected safe exit 1 with ${expected}; got ${result}: ${output} ${error}")
endif()
