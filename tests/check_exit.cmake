if(CASE STREQUAL "unknown_option")
    set(args --flash-firmware)
    set(expected "unknown option")
elseif(CASE STREQUAL "missing_config")
    set(args --config "${CMAKE_CURRENT_BINARY_DIR}/nonexistent-psvr-config.json")
    set(expected "cannot open config")
elseif(CASE STREQUAL "invalid_config")
    set(args --config "${FIXTURE}")
    set(expected "invalid diagnostic config")
elseif(CASE STREQUAL "conflicting_actions")
    set(args --power-on --power-off)
    set(expected "only one control action")
elseif(CASE STREQUAL "enumerate_action")
    set(args --enumerate-only --vr-mode)
    set(expected "action cannot be combined")
elseif(CASE STREQUAL "dry_run_without_action")
    set(args --dry-run)
    set(expected "requires one power/mode action")
elseif(CASE STREQUAL "imu_control_conflict")
    set(args --imu --power-on)
    set(expected "IMU capture cannot be combined")
elseif(CASE STREQUAL "imu_short_duration")
    set(args --imu --duration-ms 1000)
    set(expected "IMU duration must exceed")
elseif(CASE STREQUAL "imu_bad_axis")
    set(args --axis-test arbitrary)
    set(expected "axis-test must be")
elseif(CASE STREQUAL "imu_empty_axis")
    set(expected "axis-test value cannot be empty")
else()
    message(FATAL_ERROR "Unknown test case")
endif()
if(CASE STREQUAL "imu_empty_axis")
    execute_process(COMMAND "${DIAG}" --axis-test "" RESULT_VARIABLE result
        OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 10)
else()
    execute_process(COMMAND "${DIAG}" ${args} RESULT_VARIABLE result
        OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 10)
endif()
if(NOT result STREQUAL "1" OR NOT error MATCHES "${expected}" OR output MATCHES "USB detection started")
    message(FATAL_ERROR "Expected safe exit 1 with ${expected}; got ${result}: ${output} ${error}")
endif()
